# Скопируйте в apps/api/.env и заполните. Файл .env не коммитится.
# Описание всех переменных — docs/deployment.md

NODE_ENV=development
PORT=3000

# PostgreSQL. Для локальной разработки — контейнер из docker/docker-compose.yml.
# Neon: DATABASE_URL — строка с connection pooling, DIRECT_URL — прямое подключение
# (нужно для миграций). Локально обе строки одинаковые.
DATABASE_URL="postgresql://oku:oku@localhost:5432/oku_24_dev?schema=public"
DIRECT_URL="postgresql://oku:oku@localhost:5432/oku_24_dev?schema=public"

# Access-токен JWT (в production секрет — не короче 32 символов)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m

# Refresh-токен в httpOnly cookie. В production COOKIE_SECURE=true (только HTTPS).
# COOKIE_SAMESITE=none — если frontend и API на разных доменах (требует COOKIE_SECURE=true)
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Адрес frontend — для ссылок в письмах
FRONTEND_URL=http://localhost:3001

# Адреса frontend, которым разрешены запросы к API (через запятую)
CORS_ORIGINS=http://localhost:3001

# Ограничение частоты запросов: не больше THROTTLE_LIMIT запросов за THROTTLE_TTL_MS
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
# Строже — для входа, регистрации и восстановления пароля
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10

# Почта: log — письма выводятся в консоль (разработка), smtp — отправка через SMTP
MAIL_TRANSPORT=log
MAIL_FROM="OKU_24 <no-reply@oku24.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Swagger-документация на /api/docs
SWAGGER_ENABLED=true

# S3-совместимое хранилище. Ниже — локальный SeaweedFS из docker/docker-compose.yml.
# Production: S3_ENDPOINT пустой для AWS S3 или адрес сервиса (Cloudflare R2, Yandex и т.п.),
# MEDIA_PUBLIC_BASE_URL — адрес CDN перед публичным бакетом, S3_CREATE_BUCKETS=false.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=oku-s3-key
S3_SECRET_ACCESS_KEY=oku-s3-secret
S3_PUBLIC_BUCKET=oku-24-public
S3_PRIVATE_BUCKET=oku-24-private
S3_FORCE_PATH_STYLE=true
S3_CREATE_BUCKETS=true
MEDIA_PUBLIC_BASE_URL=http://localhost:8333/oku-24-public

# Redis — кэш каталога. Пустой — кэш отключён
REDIS_URL=redis://localhost:6379

# Пользователи для pnpm db:seed (только разработка). Пустые — пользователи не создаются.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
