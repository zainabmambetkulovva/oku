{
  "name": "oku_24",
  "version": "0.0.0",
  "private": true,
  "description": "OKU_24 — Online bookstore for physical books and audiobooks",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p apps/api/tsconfig.json",
    "start": "node dist/apps/api/main",
    "start:dev": "cd apps/api && nest start --watch",
    "test": "jest",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "db:migrate:dev": "cd apps/api && prisma migrate dev",
    "db:migrate:deploy": "cd apps/api && prisma migrate deploy",
    "db:push": "cd apps/api && prisma db push",
    "db:seed": "cd apps/api && ts-node prisma/seed.ts",
    "db:studio": "cd apps/api && prisma studio"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
