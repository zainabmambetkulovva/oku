# Скопируйте в apps/api/.env и заполните. Файл .env не коммитится.

NODE_ENV=development
PORT=3000

# PostgreSQL. Для локальной разработки — контейнер из docker/docker-compose.yml.
# Для Neon: строка подключения с ?sslmode=require
DATABASE_URL="postgresql://oku:oku@localhost:5432/oku_24_dev?schema=public"

# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# S3-совместимое хранилище (обложки и аудиофайлы)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
