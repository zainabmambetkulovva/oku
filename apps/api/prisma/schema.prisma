// Prisma-схема OKU_24. Спецификация: docs/database-specification.md
//
// Ограничения, которые Prisma не умеет описывать (CHECK), добавлены SQL-кодом
// в миграции prisma/migrations/*_init/migration.sql. Prisma их не трогает.
//
// Правила удаления:
//  - личные данные пользователя (сессии, адреса, токены, корзина, избранное,
//    отзывы, уведомления, прогресс) удаляются вместе с пользователем (Cascade);
//  - финансовая история (заказы, позиции, платежи, доступы) удалению не
//    подлежит (Restrict);
//  - при удалении товара позиции заказа сохраняются со снимком названия и цены,
//    ссылка на товар обнуляется (SetNull).
//
// Деньги хранятся целыми числами в минимальных единицах валюты (тыйын для KGS).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // Прямое подключение без pooling — для миграций Neon
  directUrl  = env("DIRECT_URL")
  extensions = [pg_trgm]
}

// ─── Перечисления ────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum UserRole {
  USER
  ADMIN
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  BOOK
  AUDIOBOOK
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CARD
  CASH
  TERMINAL
  ONLINE
  QR
}

enum DeliveryMethod {
  COURIER
  PICKUP
  POST
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_PROCESSING
  ORDER_SHIPPED
  ORDER_COMPLETED
  ORDER_CANCELLED
  ORDER_REFUNDED
  ACCESS_GRANTED
  REVIEW_CREATED
  PROMOTION
  SYSTEM
}

// ─── Пользователи и авторизация ──────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String?    @map("password_hash")
  firstName           String?    @map("first_name")
  lastName            String?    @map("last_name")
  phone               String?
  avatarKey           String?    @map("avatar_key")
  status              UserStatus @default(ACTIVE)
  role                UserRole   @default(USER)
  emailVerifiedAt     DateTime?  @map("email_verified_at")
  // Защита от перебора паролей: после N неудачных попыток вход блокируется до lockedUntil
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until")
  deletedAt           DateTime?  @map("deleted_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  addresses               Address[]
  sessions                Session[]
  orders                  Order[]
  cart                    Cart?
  favorites               Favorite[]
  reviews                 Review[]
  notifications           Notification[]
  listeningProgress       ListeningProgress[]
  audioAccess             AudioAccess[]
  auditLogs               AuditLog[]
  orderStatusChanges      OrderStatusHistory[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  title         String
  recipientName String   @map("recipient_name")
  phone         String
  country       String
  city          String
  street        String
  building      String
  apartment     String?
  postalCode    String?  @map("postal_code")
  comment       String?
  // Не больше одного адреса по умолчанию — обеспечивает backend (модуль users)
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  // Один активный токен на пользователя: новый запрос заменяет старый
  userId    String   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  // Один активный токен на пользователя: новый запрос заменяет старый
  userId    String   @unique @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// ─── Каталог ─────────────────────────────────────────────────────────────────

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  imageKey    String?   @map("image_key")
  // Категорию с подкатегориями удалить нельзя (Restrict)
  parentId    String?   @map("parent_id")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  bookCategories      BookCategory[]
  audiobookCategories AudiobookCategory[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model Book {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  author          String
  description     String?
  coverKey        String?       @map("cover_key")
  publisher       String?
  publicationYear Int?          @map("publication_year")
  pages           Int?
  // Код языка: ru | ky | en (CHECK)
  language        String?
  isbn            String?       @unique
  price           Int
  currency        String        @default("KGS")
  stockQuantity   Int           @default(0) @map("stock_quantity")
  // Продано экземпляров по оплаченным заказам — для сортировки «популярные»
  salesCount      Int           @default(0) @map("sales_count")
  status          ProductStatus @default(DRAFT)
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  bookCategories BookCategory[]
  bookImages     BookImage[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  favorites      Favorite[]
  reviews        Review[]

  // Поиск по части названия и автора (pg_trgm)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_title_trgm_idx")
  @@index([author(ops: raw("gin_trgm_ops"))], type: Gin, map: "books_author_trgm_idx")
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, salesCount])
  @@map("books")
}

model BookCategory {
  bookId     String @map("book_id")
  categoryId String @map("category_id")

  book     Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookId, categoryId])
  @@index([categoryId])
  @@map("book_categories")
}

model BookImage {
  id         String   @id @default(uuid())
  bookId     String   @map("book_id")
  storageKey String   @map("storage_key")
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, sortOrder])
  @@map("book_images")
}

// ─── Аудиокниги ──────────────────────────────────────────────────────────────

model Audiobook {
  id              String        @id @default(uuid())
  title           String
  slug            String        @unique
  author          String
  narrator        String?
  description     String?
  coverKey        String?       @map("cover_key")
  // Код языка: ru | ky | en (CHECK)
  language        String?
  // Сумма длительностей глав. У опубликованной аудиокниги должна быть > 0 (CHECK)
  durationSeconds Int           @default(0) @map("duration_seconds")
  price           Int
  currency        String        @default("KGS")
  // Продано по оплаченным заказам — для сортировки «популярные»
  salesCount      Int           @default(0) @map("sales_count")
  status          ProductStatus @default(DRAFT)
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  audioChapters       AudioChapter[]
  audiobookCategories AudiobookCategory[]
  audioAccess         AudioAccess[]
  listeningProgress   ListeningProgress[]
  cartItems           CartItem[]
  orderItems          OrderItem[]
  favorites           Favorite[]
  reviews             Review[]

  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "audiobooks_title_trgm_idx")
  @@index([author(ops: raw("gin_trgm_ops"))], type: Gin, map: "audiobooks_author_trgm_idx")
  @@index([status, createdAt])
  @@index([status, price])
  @@index([status, salesCount])
  @@map("audiobooks")
}

model AudioChapter {
  id              String   @id @default(uuid())
  audiobookId     String   @map("audiobook_id")
  title           String
  description     String?
  chapterNumber   Int      @map("chapter_number")
  durationSeconds Int      @map("duration_seconds")
  // Ключ файла в S3. Сам файл в БД не хранится
  storageKey      String   @map("storage_key")
  isFreePreview   Boolean  @default(false) @map("is_free_preview")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  audiobook         Audiobook           @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  listeningProgress ListeningProgress[]

  @@unique([audiobookId, chapterNumber])
  @@map("audio_chapters")
}

model AudiobookCategory {
  audiobookId String @map("audiobook_id")
  categoryId  String @map("category_id")

  audiobook Audiobook @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([audiobookId, categoryId])
  @@index([categoryId])
  @@map("audiobook_categories")
}

model AudioAccess {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  audiobookId String    @map("audiobook_id")
  // Покупка, по которой выдан доступ. null — доступ выдан другим разрешённым способом
  orderItemId String?   @map("order_item_id")
  grantedAt   DateTime  @default(now()) @map("granted_at")
  expiresAt   DateTime? @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  audiobook Audiobook  @relation(fields: [audiobookId], references: [id], onDelete: Restrict)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: Restrict)

  @@unique([userId, audiobookId])
  @@index([audiobookId])
  @@index([orderItemId])
  @@map("audio_access")
}

// ─── Корзина ─────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String   @map("cart_id")
  // Ровно одно из bookId / audiobookId (CHECK). Для аудиокниги quantity = 1 (CHECK)
  bookId      String?  @map("book_id")
  audiobookId String?  @map("audiobook_id")
  quantity    Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  cart      Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  book      Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  audiobook Audiobook? @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([cartId, bookId])
  @@unique([cartId, audiobookId])
  @@index([bookId])
  @@index([audiobookId])
  @@map("cart_items")
}

// ─── Заказы ──────────────────────────────────────────────────────────────────

model Order {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  orderNumber     String          @unique @map("order_number")
  status          OrderStatus     @default(PENDING)
  subtotal        Int
  deliveryPrice   Int             @default(0) @map("delivery_price")
  discount        Int             @default(0)
  total           Int
  currency        String          @default("KGS")
  // Снимок данных получателя на момент оформления
  recipientName   String          @map("recipient_name")
  recipientPhone  String          @map("recipient_phone")
  // null — самовывоз или заказ только из аудиокниг
  deliveryAddress String?         @map("delivery_address")
  // null — заказ только из аудиокниг, доставка не нужна
  deliveryMethod  DeliveryMethod? @map("delivery_method")
  paymentMethod   PaymentMethod   @default(ONLINE) @map("payment_method")
  comment         String?
  // Срок оплаты онлайн-заказа: после него заказ отменяется, товар возвращается в продажу
  expiresAt       DateTime?       @map("expires_at")
  completedAt     DateTime?       @map("completed_at")
  cancelledAt     DateTime?       @map("cancelled_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  // Тип товара сохраняется навсегда, даже если сам товар удалён
  productType     ProductType @map("product_type")
  bookId          String?     @map("book_id")
  audiobookId     String?     @map("audiobook_id")
  // Снимок товара на момент покупки
  productTitle    String      @map("product_title")
  productAuthor   String      @map("product_author")
  productCoverKey String?     @map("product_cover_key")
  quantity        Int
  unitPrice       Int         @map("unit_price")
  totalPrice      Int         @map("total_price")
  currency        String      @default("KGS")
  createdAt       DateTime    @default(now()) @map("created_at")

  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  book        Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)
  audiobook   Audiobook?    @relation(fields: [audiobookId], references: [id], onDelete: SetNull)
  audioAccess AudioAccess[]

  @@index([orderId])
  @@index([bookId])
  @@index([audiobookId])
  @@map("order_items")
}

model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  // null у первой записи — при создании заказа
  oldStatus   OrderStatus? @map("old_status")
  newStatus   OrderStatus  @map("new_status")
  // null — изменение выполнено системой (например, вебхуком оплаты)
  changedById String?      @map("changed_by_id")
  comment     String?
  createdAt   DateTime     @default(now()) @map("created_at")

  order     Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_history")
}

// ─── Платежи ─────────────────────────────────────────────────────────────────

model Payment {
  id                String        @id @default(uuid())
  // Один заказ может иметь несколько попыток оплаты
  orderId           String        @map("order_id")
  provider          String
  providerPaymentId String?       @map("provider_payment_id")
  amount            Int
  currency          String        @default("KGS")
  status            PaymentStatus @default(PENDING)
  paymentMethod     PaymentMethod @default(ONLINE) @map("payment_method")
  // Страница оплаты у провайдера
  paymentUrl        String?       @map("payment_url")
  paidAt            DateTime?     @map("paid_at")
  // Требует ручного разбора: оплата пришла по отменённому заказу или с неверной суммой
  requiresReview    Boolean       @default(false) @map("requires_review")
  reviewReason      String?       @map("review_reason")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentEvents PaymentEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
  @@index([status])
  @@index([requiresReview])
  @@index([createdAt])
  @@map("payments")
}

model PaymentEvent {
  id              String    @id @default(uuid())
  provider        String
  // Уникальность (provider, externalEventId) защищает от повторной обработки
  externalEventId String    @map("external_event_id")
  paymentId       String?   @map("payment_id")
  eventType       String    @map("event_type")
  // Тело уведомления провайдера — для разбора спорных ситуаций
  payload         Json?
  processedAt     DateTime? @map("processed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@map("payment_events")
}

// ─── Избранное и отзывы ──────────────────────────────────────────────────────

model Favorite {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  // Ровно одно из bookId / audiobookId (CHECK)
  bookId      String?  @map("book_id")
  audiobookId String?  @map("audiobook_id")
  createdAt   DateTime @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  audiobook Audiobook? @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@unique([userId, audiobookId])
  @@index([bookId])
  @@index([audiobookId])
  @@map("favorites")
}

model Review {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  // Ровно одно из bookId / audiobookId (CHECK). rating от 1 до 5 (CHECK)
  bookId      String?      @map("book_id")
  audiobookId String?      @map("audiobook_id")
  rating      Int
  text        String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book?      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  audiobook Audiobook? @relation(fields: [audiobookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@unique([userId, audiobookId])
  @@index([bookId, status])
  @@index([audiobookId, status])
  @@index([status])
  @@map("reviews")
}

// ─── История прослушивания ───────────────────────────────────────────────────

model ListeningProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  audiobookId     String    @map("audiobook_id")
  chapterId       String?   @map("chapter_id")
  positionSeconds Int       @default(0) @map("position_seconds")
  completed       Boolean   @default(false)
  lastListenedAt  DateTime? @map("last_listened_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  audiobook Audiobook     @relation(fields: [audiobookId], references: [id], onDelete: Cascade)
  chapter   AudioChapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)

  @@unique([userId, audiobookId])
  @@index([userId, lastListenedAt])
  @@index([audiobookId])
  @@index([chapterId])
  @@map("listening_progress")
}

// ─── Уведомления и подписка ──────────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")
  readAt    DateTime?        @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
  @@map("notifications")
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscribers")
}

// ─── Административный журнал ─────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  // null — пользователь удалён, запись журнала сохраняется
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
