# Адрес API для запросов с сервера Next.js (локально и в CI).
# На Vercel не нужен: адрес сервиса api подставляется через binding API_SERVICE_URL.
API_URL=http://localhost:3000/api/v1
# Адрес API для запросов из браузера (локально, когда API на другом порту).
# На Vercel не задавать: браузер обращается к /api/v1 на том же домене.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Контакты в подвале. Пустые — строка не показывается
# WhatsApp магазина (по умолчанию +996 779 040 589)
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/oku_24/

# Служебный ключ для запросов сервера сайта к API (тот же, что у API). Только на сервере
INTERNAL_API_TOKEN=
